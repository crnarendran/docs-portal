rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /portal_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Pre-provisioned access for an email that hasn't signed in yet.
    // Consumed (read + deleted) by the createPortalUserDocument trigger via
    // the Admin SDK on that email's first sign-in, which bypasses these
    // rules entirely — this only governs the admin panel's own read/write.
    match /portal_invites/{email} {
      allow read, write: if isAdmin();
    }

    function hasProjectAccess(projectId) {
      let userDoc = get(/databases/$(database)/documents/portal_users/$(request.auth.uid));
      let projects = userDoc != null ? userDoc.data.get('accessibleProjects', []) : [];
      return isAdmin() || projectId in projects || '*' in projects || projectId == 'sanjeev-ai';
    }

    match /portal_docs/{docId} {
      allow read: if isSignedIn() && hasProjectAccess(resource.data.project);
      allow write: if false; // Only Admin SDK can write
    }

    match /portal_docs_dev/{docId} {
      allow read: if isSignedIn() && hasProjectAccess(resource.data.project);
      allow write: if false; // Only Admin SDK can write
    }
  }
}
